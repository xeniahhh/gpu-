{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fabricsandbox/simulation-v2.schema.json",
  "title": "FabricSandbox v2 workload simulation specification",
  "$comment": "Structural schema. Cross-field geometry, provenance, exclusivity, active resource budgets and model-specific semantic checks are enforced by validation.py and adapters.",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "topology"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "scenario": {
      "enum": [
        "ddp",
        "tp"
      ]
    },
    "horizon_ms": {
      "type": "number",
      "minimum": 1,
      "maximum": 60000
    },
    "topology": {
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "rack_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "rack_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "gpu_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "memory_gib": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              }
            }
          }
        },
        "node_bandwidth_gbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "uplink_bandwidth_gbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "local_bandwidth_gbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "SYNTHETIC",
            "MEASURED",
            "DERIVED"
          ]
        }
      }
    },
    "faults": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "at_ms",
          "type",
          "target_id"
        ],
        "properties": {
          "at_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 60000
          },
          "type": {
            "enum": [
              "node_down",
              "node_up",
              "resource_down",
              "resource_up"
            ]
          },
          "target_id": {
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "world_size": {
            "enum": [
              1,
              2,
              4,
              8
            ]
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "checkpoint_interval": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      }
    },
    "model": {
      "type": "object"
    },
    "replicas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "gpu_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tp_size": {
            "enum": [
              1,
              2,
              4
            ]
          },
          "gpu_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "max_new_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "ddp"
          }
        }
      },
      "then": {
        "required": [
          "jobs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "tp"
          }
        }
      },
      "then": {
        "required": [
          "replicas",
          "requests"
        ]
      }
    }
  ]
}