+        self.assertEqual(evidence["result.evaluation.links[0]"], self.run["result"]["evaluation"]["links"][0])
+        self.assertIn("40 Gbps", answer["answer"])
+        self.assertIn("不是实测链路利用率", answer["answer"])
+        json.dumps(answer, ensure_ascii=False)
